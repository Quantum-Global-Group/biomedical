# Browser-visible. Set to the public API origin in prod.
# Must match FastAPI --port (pnpm dev:api uses 8000). Wrong port causes
# "API offline / fetch failed" at hydration (API_INTERNAL_URL) or in the
# browser when the dev API proxy is disabled.
# Hugging Face default export (`pnpm export:hf`) enables remote API automatically.
# For offline HF fixture builds use `pnpm export:hf:demo` instead (no Fly).
NEXT_PUBLIC_LITE_REMOTE_API=false

# Optional: backend URL for the Next dev proxy (defaults to http://127.0.0.1:8000).
# If you change HETQML_API_PORT when running `pnpm dev:api`, set this to match.
# HETQML_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Server-only. On Fly, set to http://hetqml-api.internal:8000
# Locally, same host/port as uvicorn (must match HETQML_API_PORT if you override it).
API_INTERNAL_URL=http://localhost:8000

# Alternate ports from repo root (Linux/macOS/WSL):
#   HETQML_WEB_PORT=3001 HETQML_API_PORT=8001 pnpm dev:web
#   HETQML_API_PORT=8001 pnpm dev:api
# Then in .env.local set API_INTERNAL_URL + HETQML_DEV_API_PROXY_TARGET to :8001
# (browser client uses /__hetqml_api in dev; CORS already allows any localhost port).
