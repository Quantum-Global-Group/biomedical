# Comma-separated list of allowed origins for CORS.
# Local dev (localhost:PORT / 127.0.0.1:PORT is also allowed via regex in main.py):
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production (Fly): https://hetqml-web.fly.dev

# Optional: smaller IBM hardware kernel batches (quantum family only).
# Integer in [25, 60]; omit for full QK sample size (~more circuits).
# HETQML_QUANTUM_HW_SAMPLES=35
